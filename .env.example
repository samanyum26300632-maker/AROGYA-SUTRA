APP_NAME=AROGYA-SUTRA API
ENV=dev
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
DATABASE_URL=sqlite+aiosqlite:///./arogya_sutra.db
POSTGRES_URL=postgresql+asyncpg://arogya:arogya@postgres:5432/arogya
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=http://localhost:3000,https://your-production-frontend.example
AUTO_CREATE_TABLES=true
